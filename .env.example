# ==========================================
# SwasthyaSetu Environment Configuration Template
# ==========================================

# ------------------------------------------
# Backend Configuration
# ------------------------------------------
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB URI)
# Local: mongodb://127.0.0.1:27017/swasthyasetu
# Cloud: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/swasthyasetu?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/swasthyasetu

# CORS Allowed Origin for Frontend
# Example: https://swasthyasetu.vercel.app or http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ------------------------------------------
# Frontend Configuration
# ------------------------------------------
# Base URL for backend API endpoints
# Local: http://localhost:5000/api
# Deployed: https://swasthyasetu-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

