# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas for Production, localhost for Dev)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/swasthyasetu?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/swasthyasetu?retryWrites=true&w=majority

# CORS: Deployed Frontend URL on Vercel (comma-separated or single URL)
# Example: https://swasthyasetu.vercel.app
FRONTEND_URL=https://your-frontend-app.vercel.app

