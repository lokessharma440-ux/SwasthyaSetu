# Backend API Base URL
# In production on Vercel, set this to your deployed Render backend service URL.
# Note: You can provide either the domain or the /api path (both are auto-handled):
# Example: https://swasthyasetu-api.onrender.com
# Example: https://swasthyasetu-api.onrender.com/api
VITE_API_URL=https://your-backend.onrender.com/api
